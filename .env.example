# Copy this file to `.env` and fill in your own values. `.env` is gitignored, so never commit it.
# Keys are read by the generation clients via python-dotenv. Never print or log them.

OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Publishing (used only after explicit approval)
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional 4th vendor
ANTHROPIC_API_KEY=

# Hard spending cap (USD) that the generation runner checks before launching any paid job
BUDGET_USD=25
